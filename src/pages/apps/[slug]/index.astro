---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.tsx";
import Footer from "../../../components/Footer.tsx";
import ReleaseInfo from "../../../components/ReleaseInfo.tsx";
import { APPS } from "../../../data/apps.ts";
import type { AppEntry } from "../../../data/apps.ts";

export function getStaticPaths() {
  return APPS.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
const kind = app.kind === "game" ? "game" : "app";
const pageUrl = `https://behemehal.org/apps/${app.slug}`;

// Everything here shipped to Android until QuicKV, so that stays the default.
const platforms = app.platforms ?? ["Android"];
const isMobile = platforms.some((os) => os === "Android" || os === "iOS");
// Desktop screenshots are landscape; a phone's are not, and one frame cannot serve
// both without cropping the screen out of one of them.
const landscape = app.orientation === "landscape";
// Wider than a phone shot needs to be: a desktop UI at 560px is a picture of a
// window rather than something you can read. The rail scrolls either way.
const shotWidth = landscape ? 680 : 248;
const shotHeight = landscape ? 425 : 441;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": app.kind === "game" ? "VideoGame" : "SoftwareApplication",
  name: app.name,
  description: app.tagline,
  url: pageUrl,
  image: new URL(app.iconPng, Astro.site).href,
  applicationCategory: app.kind === "game"
    ? "GameApplication"
    : isMobile
      ? "MobileApplication"
      : "DeveloperApplication",
  applicationSubCategory: app.category,
  operatingSystem: platforms.join(", "),
  author: { "@type": "Organization", name: app.developer, url: "https://behemehal.org" },
  publisher: { "@type": "Organization", name: app.developer, url: "https://behemehal.org" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  ...(app.playUrl ? { installUrl: app.playUrl } : {}),
  ...(app.hasPrivacyPolicy ? { privacyPolicy: `${pageUrl}/privacy` } : {}),
};
---

<Layout
  title={`${app.name} — Behemehal`}
  description={app.tagline}
  url={pageUrl}
  image={app.featureGraphic ? app.featureGraphic.replace(".webp", ".png") : app.iconPng}
  keywords={`${app.name},behemehal,${app.category},${platforms.join(" ").toLowerCase()} ${kind}`}
>
  <Navbar client:load />

  <main class="w-full pt-[50px] bg-black">
    {/* ── Hero ─────────────────────────────────────────────────────────── */}
    <section class="relative w-full overflow-hidden bg-primaryDark">
      {app.featureGraphic && (
        <div
          class="pointer-events-none absolute inset-0 scale-125 blur-3xl opacity-40"
          style={{
            backgroundImage: `url(${app.featureGraphic})`,
            backgroundSize: "cover",
            backgroundPosition: "center",
          }}
        >
        </div>
      )}
      <div
        class="pointer-events-none absolute inset-0"
        style={{
          backgroundImage:
            "linear-gradient(to bottom, rgba(66,0,4,0.55), rgba(0,0,0,0.92))",
        }}
      >
      </div>

      <div class="relative z-10 max-w-[1100px] mx-auto px-8 exsm:px-5 pt-8 pb-12">
        {/* Breadcrumb */}
        <nav aria-label="Breadcrumb" class="text-sm text-white/60">
          <a href="/" class="hover:text-white transition-colors">Behemehal</a>
          <span class="mx-2">/</span>
          <a href="/apps" class="hover:text-white transition-colors">Apps</a>
          <span class="mx-2">/</span>
          <span class="text-white/90">{app.name}</span>
        </nav>

        <div class="flex items-start gap-7 mt-8 exsm:flex-col exsm:items-center exsm:text-center exsm:gap-5">
          <img
            src={app.icon}
            width={128}
            height={128}
            alt={`${app.name} icon`}
            class="w-[128px] h-[128px] exsm:w-[104px] exsm:h-[104px] rounded-[28px] shrink-0 shadow-2xl shadow-black/60"
          />
          <div class="min-w-0">
            <h1 class="text-5xl exsm:text-4xl text-white leading-tight">{app.name}</h1>
            <p class="text-primary text-lg mt-2">{app.developer}</p>
            <p class="text-white/85 mt-3 max-w-[620px] exsm:mx-auto">{app.tagline}</p>
            <div class="flex flex-wrap gap-2 mt-4 exsm:justify-center">
              <span class="text-white text-xs uppercase tracking-widest bg-primary/80 rounded-full px-3 py-1">
                {app.category}
              </span>
              {app.tags.map((tag) => (
                <span class="text-white/85 text-xs border border-white/25 rounded-full px-3 py-1">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>

        {/* Install / links */}
        <div class="flex flex-wrap items-center gap-4 mt-9 exsm:justify-center">
          {app.playUrl
            ? (
              <a
                href={app.playUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`Get ${app.name} on Google Play`}
              >
                <img
                  src="/img/google-play-badge.webp"
                  width={200}
                  height={59}
                  alt="Get it on Google Play"
                  class="w-[200px] h-auto"
                />
              </a>
            )
            : app.releases
            ? (
              <>
                {/* Versions cannot be baked into a static page without redeploying
                    on every release, so they are fetched. Without JavaScript the
                    noscript below says the honest static thing. */}
                <ReleaseInfo client:load slug={app.slug} />
                <noscript>
                  <span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white/85 px-5 py-3 rounded-md">
                    Downloads need JavaScript — or ask us at {app.supportEmail}.
                  </span>
                </noscript>
              </>
            )
            : (
              <span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white/85 px-5 py-3 rounded-md">
                <span class="material-symbols-outlined" style={{ fontSize: "20px" }}>
                  hourglass_top
                </span>
                {isMobile ? "Coming soon to Google Play" : "Coming soon"}
              </span>
            )}

          {app.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-2 border border-white/60 hover:bg-white/10 transition-colors text-white px-5 py-3 rounded-md"
            >
              <span class="material-symbols-outlined" style={{ fontSize: "20px" }}>
                {link.icon}
              </span>
              {link.label}
            </a>
          ))}
        </div>

        {/* Stat strip */}
        {app.stats.length > 0 && (
          <div class="grid grid-cols-[repeat(auto-fit,minmax(130px,1fr))] exsm:grid-cols-2 gap-y-7 divide-x divide-white/15 exsm:divide-x-0 mt-10 border-t border-white/10 pt-6">
            {app.stats.map((stat) => (
              <div class="px-7 exsm:px-3 text-center">
                {stat.icon
                  ? (
                    <span
                      class="material-symbols-outlined text-white block"
                      style={{ fontSize: "26px" }}
                    >
                      {stat.icon}
                    </span>
                  )
                  : <p class="text-white text-2xl font-bold leading-none">{stat.value}</p>}
                <p class="text-white/60 text-xs mt-2">{stat.label}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    {/* ── Screenshots ──────────────────────────────────────────────────── */}
    {app.screenshots.length > 0 && (
      <section class="w-full bg-black py-12">
        <div class="max-w-[1100px] mx-auto">
          <h2 class="text-2xl text-white px-8 exsm:px-5">Screenshots</h2>
          <div class="app-rail flex gap-4 overflow-x-auto snap-x snap-mandatory px-8 exsm:px-5 pt-5 pb-4">
            {app.screenshots.map((shot, i) => (
              <figure class="snap-center shrink-0" style={{ width: `${shotWidth}px` }}>
                {/* A screenshot in the rail is 680px wide at most, which for a desktop
                    UI is a picture of a window rather than something you can read.
                    Pressing it opens the file at its own size. */}
                <button
                  type="button"
                  class="shot-open block w-full cursor-zoom-in rounded-2xl"
                  data-shot={i}
                  aria-label={`Open screenshot: ${shot.caption}`}
                >
                  <img
                    src={shot.src}
                    width={shotWidth}
                    height={shotHeight}
                    loading="lazy"
                    alt={shot.caption}
                    class="rounded-2xl border border-white/10 bg-primaryDark w-full h-auto"
                  />
                </button>
                {/* A desktop screenshot is dense enough that the caption is doing real
                    work; on a phone shot the picture says it already. */}
                {landscape && (
                  <figcaption class="text-white/60 text-xs mt-3 leading-relaxed">
                    {shot.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>

          <dialog id="shot-viewer" class="shot-viewer" aria-label="Screenshot">
            <button type="button" class="shot-nav shot-prev" data-step="-1" aria-label="Previous screenshot">&lsaquo;</button>
            <figure class="shot-stage">
              <img id="shot-viewer-img" src="" alt="" />
              <figcaption id="shot-viewer-caption"></figcaption>
            </figure>
            <button type="button" class="shot-nav shot-next" data-step="1" aria-label="Next screenshot">&rsaquo;</button>
            <button type="button" class="shot-close" aria-label="Close">&times;</button>
          </dialog>
        </div>
      </section>
    )}

    {/* ── About ────────────────────────────────────────────────────────── */}
    <section class="w-full bg-black pb-12">
      <div class="max-w-[1100px] mx-auto px-8 exsm:px-5">
        <div class="relative bg-surface border border-white/10 rounded-2xl p-7 exsm:p-5">
          <h2 class="text-2xl text-white">About this {kind}</h2>

          <input type="checkbox" id="about-more" class="peer sr-only" />

          <div class="max-h-[300px] overflow-hidden peer-checked:max-h-none transition-[max-height] duration-300">
            {app.about.map((paragraph) => (
              <p class="text-white/85 mt-4 leading-relaxed">{paragraph}</p>
            ))}

            {app.sections.map((section) => (
              <div class="mt-7">
                <h3 class="text-white text-lg">{section.heading}</h3>
                <ul class="mt-3 grid grid-cols-2 exsm:grid-cols-1 gap-x-8 gap-y-2">
                  {section.items.map((item) => (
                    <li class="flex gap-3 text-white/85 text-sm leading-relaxed">
                      <span class="mt-[8px] w-[5px] h-[5px] rounded-full bg-primary shrink-0">
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <div
            class="pointer-events-none absolute left-0 right-0 bottom-[62px] h-28 rounded-b-2xl bg-gradient-to-t from-surface to-transparent peer-checked:opacity-0 transition-opacity"
          >
          </div>

          <label
            for="about-more"
            class="peer-checked:hidden inline-flex items-center gap-1 mt-6 text-primary hover:text-white transition-colors cursor-pointer select-none"
          >
            Read more
            <span class="material-symbols-outlined" style={{ fontSize: "18px" }}>
              expand_more
            </span>
          </label>
          <label
            for="about-more"
            class="hidden peer-checked:inline-flex items-center gap-1 mt-6 text-primary hover:text-white transition-colors cursor-pointer select-none"
          >
            Show less
            <span class="material-symbols-outlined" style={{ fontSize: "18px" }}>
              expand_less
            </span>
          </label>
        </div>
      </div>
    </section>

    {/* ── Data safety ──────────────────────────────────────────────────── */}
    {app.dataSafety.length > 0 && (
      <section class="w-full bg-black pb-12">
        <div class="max-w-[1100px] mx-auto px-8 exsm:px-5">
          <div class="bg-surface border border-white/10 rounded-2xl p-7 exsm:p-5">
            <h2 class="text-2xl text-white">Data safety</h2>
            <p class="text-white/70 text-sm mt-2 max-w-[720px]">
              Safety starts with understanding how developers collect and share your
              data. Here is what this {kind} does.
            </p>
            <div class="grid grid-cols-2 exsm:grid-cols-1 gap-x-10 gap-y-6 mt-7">
              {app.dataSafety.map((row) => (
                <div class="flex gap-4">
                  <span
                    class="material-symbols-outlined text-primary shrink-0"
                    style={{ fontSize: "24px" }}
                  >
                    {row.icon}
                  </span>
                  <div>
                    <h3 class="text-white text-base">{row.title}</h3>
                    <p class="text-white/70 text-sm mt-1 leading-relaxed">{row.body}</p>
                  </div>
                </div>
              ))}
            </div>
            {app.hasPrivacyPolicy && (
              <a
                href={`/apps/${app.slug}/privacy`}
                class="inline-flex items-center gap-1 mt-7 text-primary hover:text-white transition-colors"
              >
                Read the full privacy policy
                <span class="material-symbols-outlined" style={{ fontSize: "18px" }}>
                  arrow_forward
                </span>
              </a>
            )}
          </div>
        </div>
      </section>
    )}

    {/* ── Rating + info + support ──────────────────────────────────────── */}
    <section class="w-full bg-black pb-16">
      <div class="max-w-[1100px] mx-auto px-8 exsm:px-5 grid grid-cols-2 exsm:grid-cols-1 gap-6">
        <div class="bg-surface border border-white/10 rounded-2xl p-7 exsm:p-5">
          <h2 class="text-2xl text-white">{app.kind === "game" ? "Game" : "App"} info</h2>
          <dl class="mt-5">
            {app.info.map((row) => (
              <div class="flex gap-4 py-3 border-t border-white/10 first:border-t-0">
                <dt class="text-white/60 text-sm w-[42%] shrink-0">{row.label}</dt>
                <dd class="text-white text-sm">{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="flex flex-col gap-6">
          <div class="bg-surface border border-white/10 rounded-2xl p-7 exsm:p-5">
            <h2 class="text-2xl text-white">Content rating</h2>
            <p class="inline-flex items-center gap-2 mt-4 text-white text-lg">
              <span class="material-symbols-outlined text-primary" style={{ fontSize: "24px" }}>
                verified_user
              </span>
              {app.contentRating.label}
            </p>
            <p class="text-white/70 text-sm mt-3 leading-relaxed">
              {app.contentRating.detail}
            </p>
          </div>

          <div class="bg-surface border border-white/10 rounded-2xl p-7 exsm:p-5">
            <h2 class="text-2xl text-white">Support</h2>
            <p class="text-white/70 text-sm mt-3">
              Found a bug, or stuck on a level? Write to us — a real person reads it.
            </p>
            <a
              href={`mailto:${app.supportEmail}`}
              class="inline-flex items-center gap-2 mt-4 text-primary hover:text-white transition-colors break-all"
            >
              <span class="material-symbols-outlined" style={{ fontSize: "20px" }}>mail</span>
              {app.supportEmail}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer showAttribute />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Layout>

<style>
  /* A <dialog> is the right element here: Escape closes it, focus is trapped, and
     the backdrop is the browser's rather than a div pretending to be one. */
  .shot-viewer[open] {
    display: flex;
    /* The close button anchors to the dialog, not to the viewport — without this it
       lands over the site header. */
    position: relative;
    align-items: center;
    gap: 0.5rem;
    width: min(96vw, 1800px);
    max-width: 96vw;
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .shot-viewer::backdrop {
    background: rgb(0 0 0 / 0.86);
  }
  .shot-stage {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
  }
  .shot-stage img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 84vh;
    object-fit: contain;
    border-radius: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: #0b0b0f;
  }
  .shot-stage figcaption {
    margin-top: 0.75rem;
    color: rgb(255 255 255 / 0.62);
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: center;
  }
  .shot-nav,
  .shot-close {
    flex: 0 0 auto;
    color: rgb(255 255 255 / 0.72);
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    cursor: pointer;
    line-height: 1;
  }
  .shot-nav {
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.6rem;
  }
  .shot-nav:hover,
  .shot-close:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.16);
  }
  .shot-nav[disabled] {
    opacity: 0.25;
    cursor: default;
  }
  .shot-close {
    /* Inside the dialog, not above it: the dialog is nearly the height of the
       viewport, so a negative offset puts this over the site's own header. The
       next arrow is vertically centred, so the two do not meet. */
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.25rem;
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(6px);
  }
  /* On a phone the arrows would eat the picture, so the swipeable rail stays the
     way through the set and the viewer is just "bigger". */
  @media (max-width: 640px) {
    .shot-nav { display: none; }
  }
</style>

<script>
  const viewer = document.getElementById("shot-viewer") as HTMLDialogElement | null;
  const image = document.getElementById("shot-viewer-img") as HTMLImageElement | null;
  const caption = document.getElementById("shot-viewer-caption");
  const openers = [...document.querySelectorAll<HTMLButtonElement>(".shot-open")];

  if (viewer && image && caption && openers.length) {
    // Read off the rail's own <img>s rather than passing the list down twice: one
    // source for what is on the page and what the viewer shows.
    const shots = openers.map((button) => {
      const img = button.querySelector("img");
      return { src: img?.getAttribute("src") ?? "", caption: img?.getAttribute("alt") ?? "" };
    });
    let at = 0;

    const show = (index: number) => {
      at = Math.max(0, Math.min(shots.length - 1, index));
      image.src = shots[at].src;
      image.alt = shots[at].caption;
      caption.textContent = shots[at].caption;
      for (const nav of viewer.querySelectorAll<HTMLButtonElement>(".shot-nav")) {
        const step = Number(nav.dataset.step ?? 0);
        nav.disabled = at + step < 0 || at + step > shots.length - 1;
      }
    };

    openers.forEach((button, index) => {
      button.addEventListener("click", () => {
        show(index);
        viewer.showModal();
      });
    });

    viewer.querySelectorAll<HTMLButtonElement>(".shot-nav").forEach((nav) => {
      nav.addEventListener("click", () => show(at + Number(nav.dataset.step ?? 0)));
    });
    viewer.querySelector(".shot-close")?.addEventListener("click", () => viewer.close());

    // A press on the backdrop closes it. The dialog fills its own box, so anything
    // landing on the element itself rather than on a child is the backdrop.
    viewer.addEventListener("click", (event) => {
      if (event.target === viewer) viewer.close();
    });

    document.addEventListener("keydown", (event) => {
      if (!viewer.open) return;
      if (event.key === "ArrowRight") show(at + 1);
      if (event.key === "ArrowLeft") show(at - 1);
    });
  }
</script>
